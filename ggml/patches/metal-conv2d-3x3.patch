+kernel void kernel_conv_2d_3x3<float>(
+        constant ggml_metal_kargs_conv_2d & args,
+        device const float * weights,
+        device const float * src,
+        device       float * dst,
+        uint3 gid[[thread_position_in_grid]]);
+
+template [[host_name("kernel_conv_2d_3x3_f16_f32")]]
+kernel void kernel_conv_2d_3x3<half>(
+        constant ggml_metal_kargs_conv_2d & args,
+        device const half  * weights,
+        device const float * src,
+        device       float * dst,
+        uint3 gid[[thread_position_in_grid]]);
