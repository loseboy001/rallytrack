diff --git a/ggml/src/ggml-metal/kernels/conv.metal b/ggml/src/ggml-metal/kernels/conv.metal
index a5d5aa9..5f8ad7d 100644
--- a/ggml/src/ggml-metal/kernels/conv.metal
+++ b/ggml/src/ggml-metal/kernels/conv.metal
@@ -282,6 +282,121 @@ typedef void (conv_transpose_1d_t)(
         uint3   tgpig[[threadgroup_position_in_grid]],
         uint3    tgpg[[threadgroups_per_grid]]);
 
+// Fast path for 3x3, stride 1, dilation 1 on contiguous [W, H, C, N] tensors.
+//
+// Each thread computes a 2x2 output tile for 4 output channels. Per input channel it loads a 4x4
+// input patch once (16 loads) and each of the 9 taps for the 4 channels once (36 loads), and
+// reuses them for all 144 multiply-adds of the tile. The generic kernel above loads one input
+// value and one weight per multiply-add.
+//
+// grid: x = OW/2, y = OH/2, z = N * ceil(OC/4)
+template <typename TK>
+kernel void kernel_conv_2d_3x3(
+        constant ggml_metal_kargs_conv_2d & args,
+        device const TK    * weights,
+        device const float * src,
+        device       float * dst,
+        uint3 gid[[thread_position_in_grid]]) {
+
+    const int32_t ow0 = 2*gid.x;
+    const int32_t oh0 = 2*gid.y;
+    if (ow0 >= args.OW || oh0 >= args.OH) {
+        return;
+    }
+
+    const int32_t ocb = (args.OC + 3)/4;
+    const int32_t n   = gid.z/ocb;
+    const int32_t oc0 = 4*(gid.z%ocb);
+
+    // weight offsets of the 4 output channels; channels past OC are clamped and dropped at the end
+    const uint wstep = 9*args.IC;
+    const uint w0 = (uint) min(oc0 + 0, args.OC - 1)*wstep;
+    const uint w1 = (uint) min(oc0 + 1, args.OC - 1)*wstep;
+    const uint w2 = (uint) min(oc0 + 2, args.OC - 1)*wstep;
+    const uint w3 = (uint) min(oc0 + 3, args.OC - 1)*wstep;
+
+    // the 4x4 input patch that covers the 2x2 output tile; positions outside the image read as zero
+    uint offs[16];
+    bool inside[16];
+    FOR_UNROLL (int j = 0; j < 4; ++j) {
+        const int32_t iy = oh0 - args.p1 + j;
+        FOR_UNROLL (int i = 0; i < 4; ++i) {
+            const int32_t ix = ow0 - args.p0 + i;
+            inside[4*j + i] = ix >= 0 && ix < args.IW && iy >= 0 && iy < args.IH;
+            offs  [4*j + i] = (uint) clamp(iy, 0, args.IH - 1)*args.IW + clamp(ix, 0, args.IW - 1);
+        }
+    }
+
+    float4 acc00 = 0.0f; // (ow0,     oh0)
+    float4 acc10 = 0.0f; // (ow0 + 1, oh0)
+    float4 acc01 = 0.0f; // (ow0,     oh0 + 1)
+    float4 acc11 = 0.0f; // (ow0 + 1, oh0 + 1)
+
+    const uint plane = (uint) args.IW*args.IH;
+    device const float * s = src + (uint) n*args.IC*plane;
+
+    for (int32_t ic = 0; ic < args.IC; ++ic) {
+        float p[16];
+        FOR_UNROLL (int i = 0; i < 16; ++i) {
+            p[i] = inside[i] ? s[offs[i]] : 0.0f;
+        }
+
+        const uint wi = 9*ic;
+        FOR_UNROLL (int ky = 0; ky < 3; ++ky) {
+            FOR_UNROLL (int kx = 0; kx < 3; ++kx) {
+                const uint k = wi + 3*ky + kx;
+                const float4 w = float4(weights[w0 + k], weights[w1 + k], weights[w2 + k], weights[w3 + k]);
+
+                acc00 += p[4*ky + kx        ]*w;
+                acc10 += p[4*ky + kx + 1    ]*w;
+                acc01 += p[4*ky + kx + 4    ]*w;
+                acc11 += p[4*ky + kx + 4 + 1]*w;
+            }
+        }
+
+        s += plane;
+    }
+
+    const bool has_x = ow0 + 1 < args.OW;
+    const bool has_y = oh0 + 1 < args.OH;
+
+    const uint oplane = (uint) args.OW*args.OH;
+    const uint o00 = (uint) n*args.OC*oplane + (uint) oh0*args.OW + ow0;
+
+    FOR_UNROLL (int c = 0; c < 4; ++c) {
+        if (oc0 + c < args.OC) {
+            const uint o = o00 + (uint) (oc0 + c)*oplane;
+
+            dst[o] = acc00[c];
+            if (has_x) {
+                dst[o + 1] = acc10[c];
+            }
+            if (has_y) {
+                dst[o + args.OW] = acc01[c];
+            }
+            if (has_x && has_y) {
+                dst[o + args.OW + 1] = acc11[c];
+            }
+        }
+    }
+}
